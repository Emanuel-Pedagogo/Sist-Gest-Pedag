# Copie para keystore.properties e preencha com os dados do keystore de upload.
# Nunca commite keystore.properties nem o arquivo .keystore/.jks.
#
# Se o app ja estiver publicado na Play Store, use o MESMO keystore da primeira versao.
# Caso contrario, gere um novo com: npm run release:android

storeFile=sacp-release.keystore
storePassword=SUA_SENHA_DO_KEYSTORE
keyAlias=sacp
keyPassword=SUA_SENHA_DA_CHAVE
